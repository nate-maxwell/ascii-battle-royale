# Moving entities displayed on the terminal grid.

let random = import("core:random")

type Point = struct {
    x: int
    y: int
}

let directions = [
    Point{0, 1},
    Point{0,-1},
    Point{-1, 0},
    Point{1, 0}
]

# Move speed + color
let profiles: array[array] = [
    [2, "#00ffff"],
    [4, "#ff33cc"],
    [8, "#ffff00"]
]

type Entity = struct {
    speed: int # Maximum travel distance in a single turn
    char: str # The character to represent the entity
    color: str # Color to display the character in termianl
    pos:: Point # Current position
    width: int # Battleground width
    height: int # Battleground height
    move_randomly: call(Entity) # Behavior for randomly moving to a new location
}

let random_move = fn(e: Entity) {
    # Randomly move the entity to a new position without crossing width and
    # height constraints.
    let direction = random.randelem(directions)
    let distance = random.randint(0, e.speed)

    let new_x = e.x + direction.x * distance
    let new_y = e.y + direction.y * distance

    if new_x >= 0 && new_x < e.width &&
    new_y >= 0 && new_y < e.height{
        e.x = new_x
        e.y = new_y
    }
}

let new_entity = fn(
    char: str, x: int, y: int, width: int, height: int, profile: array
) Entity{
    return Entity{
        profile[0],
        char,
        profile[1],
        Point{x, y},
        width,
        height,
        random_move
    }
}
